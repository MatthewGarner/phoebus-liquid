    platforms: [{ x: 2.0, y: 4.4, w: 6 }], props: [{ type: 'yarn', x: -0.4, y: 4.4 }, { type: 'orange', x: 0.3, y: 4.4 }, { type: 'mug', x: -0.5, y: 0 }] },
