// The rooms. A level = { id, name, hint, container: {id, x, y}, cat: {x, y, facing}, platforms: [{x, y, w}], props: [{type, x, y}], par }.
// World: x in [-5, 5] (the side walls bounce him), floor at y = 0. A shelf's y is its top surface; the container's y is what it stands on;
// the cat's x is the middle of him and his y the surface he sits on; a prop's y is the surface it sits on. No three/DOM imports.
// Positions were tuned with scripts/solve.mjs: every level is completable within par + 1 leaps.
export const LEVELS = [
  { id: 1, name: 'Warm-up', hint: 'A gentle lob.', par: 1,
    container: { id: 'salad', x: 2.0, y: 0 }, cat: { x: -2.6, y: 0, facing: 1 }, platforms: [], props: [] },
  { id: 2, name: 'Drop in', hint: 'Down from the shelf.', par: 1,
